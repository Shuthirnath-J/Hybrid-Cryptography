def lambda_handler(event, context):
    http_method = event.get('httpMethod')
    path = event.get('path')
    response = "error"
    
    if http_method == 'GET' and path == status_path:
            response = build_response(200, 'Service is operational')
    elif http_method == 'POST' and path == encrypt_path:
        body = json.loads(event["body"])
        plaintext = body["plaintext"]
        receiver = body["receiver"]
        encrypted_value, decrypted_value = partial(plaintext)
        data = {
            'receiver': receiver,
            'encrypted_value': encrypted_value,
            'decrypted_value': decrypted_value
        }
        response = input_mess(data)
    elif http_method == 'GET' and path == decrypt_path:
        receiver = event['queryStringParameters']['receiver']
        response = get_message(receiver)
        
    return response

def get_message(receiver):
    try:
        response = dynamodb_table.get_item(Key={'receiver': receiver})
        return build_response(200, response.get('Item'))
    except ClientError as e:
        print('Error:', e)
        return build_response(400, e.response['Error']['Message'])
        
        
def build_response(status_code, body):
    return {
        'statusCode': status_code,
        'body': json.dumps(body)
    }
    
def input_mess(request_body):
    try:
        receiver = request_body['receiver']
        encrypted_value = request_body['encrypted_value']
        decrypted_value = request_body['decrypted_value']
        request_body_str = {k: str(v) if isinstance(v, decimal.Decimal) else v for k, v in request_body.items()}
        dynamodb_table.put_item(Item={
            "receiver": receiver,
            "encrypted": encrypted_value,
            "decrypted": decrypted_value
        })
        body = {
            'Operation': 'SUCCESS',
            'Item': receiver,
            'encrypted': encrypted_value,
            'decrypted': decrypted_value
        }
        return build_response(200, body)
    except ClientError as e:
        print('Error:', e)
        return build_response(400, e.response['Error']['Message'])

