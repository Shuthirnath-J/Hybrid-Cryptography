    def text2matrix(text):
        matrix = []
        for i in range(16):
            byte = (text >> (8 * (15 - i))) & 0xFF
            if i % 4 == 0:
                matrix.append([byte])
            else:
                matrix[i // 4].append(byte)
        return matrix
 
 
    def matrix2text(matrix):
        text = 0
        for i in range(4):
            for j in range(4):
                text |= (matrix[i][j] << (120 - 8 * (4 * i + j)))
        return text
 
 
    class AES:
        def __init__(self, master_key1, master_key2):
            self.change_key(master_key1, master_key2)
 
        def change_key(self, master_key1, master_key2):
            self.round_keys1 = text2matrix(master_key1)
            self.round_keys2 = text2matrix(master_key2)
        
        
 
            for i in range(4, 4 * 11):
                self.round_keys1.append([])
                self.round_keys2.append([])
                if i % 4 == 0:
                    byte1 = self.round_keys1[i - 4][0]    \
                        ^ Sbox[self.round_keys1[i - 1][1]]    \
                        ^ Rcon[i // 4]
                    self.round_keys1[i].append(byte1)
                    self.round_keys2[i].append(byte1)
 
                    for j in range(1, 4):
                        byte1 = self.round_keys1[i - 4][j]    \
                             ^ Sbox[self.round_keys1[i - 1][(j + 1) % 4]]    \
                             ^ Sbox[self.round_keys2[i - 1][(j + 1) % 4]]
                        self.round_keys1[i].append(byte1)
                        self.round_keys2[i].append(byte1)
                else:
                    for j in range(4):
                        byte1 = self.round_keys1[i - 4][j]    \
                             ^ self.round_keys1[i - 1][j]    \
                             ^ self.round_keys2[i - 1][j]
                        self.round_keys1[i].append(byte1)
                        self.round_keys2[i].append(byte1)
 
        # print self.round_keys
 
        def encrypt_text(self, plaintext):
            plaintext_bytes = plaintext.encode('utf-8')  # Convert text to bytes
            plaintext_hex = int(plaintext_bytes.hex(), 16)  # Convert bytes to an integer
            encrypted = self.encrypt(plaintext_hex)
            return encrypted, hex(encrypted)
 
        def decrypt_text(self, ciphertext):
            decrypted_hex = self.decrypt(ciphertext)
            decrypted_bytes = bytes.fromhex(hex(decrypted_hex)[2:]).decode('utf-8')  # Convert the integer back to bytes and then to text
            return decrypted_hex,decrypted_bytes
 
        def encrypt(self, plaintext):
            self.plain_state = text2matrix(plaintext)
 
            self.__add_round_key(self.plain_state, self.round_keys1[:4])
 
            for i in range(1, 10):
                self.__round_encrypt(self.plain_state, self.round_keys1[4 * i : 4 * (i + 1)])
 
            self.__sub_bytes(self.plain_state)
            self.__shift_rows(self.plain_state)
            self.__add_round_key(self.plain_state, self.round_keys1[40:])
 
            return matrix2text(self.plain_state)
 
        def decrypt(self, ciphertext):
            self.cipher_state = text2matrix(ciphertext)
 
            self.__add_round_key(self.cipher_state, self.round_keys2[40:])
            self.__inv_shift_rows(self.cipher_state)
            self.__inv_sub_bytes(self.cipher_state)
 
            for i in range(9, 0, -1):
                self.__round_decrypt(self.cipher_state, self.round_keys2[4 * i : 4 * (i + 1)])
 
            self.__add_round_key(self.cipher_state, self.round_keys2[:4])
 
            return matrix2text(self.cipher_state)
 
        def __add_round_key(self, s, k):
            for i in range(4):
                for j in range(4):
                    s[i][j] ^= k[i][j]
 
 
        def __round_encrypt(self, state_matrix, key_matrix):
            self.__sub_bytes(state_matrix)
            self.__shift_rows(state_matrix)
            self.__mix_columns(state_matrix)
            self.__add_round_key(state_matrix, key_matrix)
 
 
        def __round_decrypt(self, state_matrix, key_matrix):
            self.__add_round_key(state_matrix, key_matrix)
            self.__inv_mix_columns(state_matrix)
            self.__inv_shift_rows(state_matrix)
            self.__inv_sub_bytes(state_matrix)
 
        def __sub_bytes(self, s):
            for i in range(4):
                for j in range(4):
                    s[i][j] = Sbox[s[i][j]]
 
 
        def __inv_sub_bytes(self, s):
            for i in range(4):
                for j in range(4):
                    s[i][j] = InvSbox[s[i][j]]
 
 
        def __shift_rows(self, s):
            s[0][1], s[1][1], s[2][1], s[3][1] = s[1][1], s[2][1], s[3][1], s[0][1]
            s[0][2], s[1][2], s[2][2], s[3][2] = s[2][2], s[3][2], s[0][2], s[1][2]
            s[0][3], s[1][3], s[2][3], s[3][3] = s[3][3], s[0][3], s[1][3], s[2][3]
 
 
        def __inv_shift_rows(self, s):
            s[0][1], s[1][1], s[2][1], s[3][1] = s[3][1], s[0][1], s[1][1], s[2][1]
            s[0][2], s[1][2], s[2][2], s[3][2] = s[2][2], s[3][2], s[0][2], s[1][2]
            s[0][3], s[1][3], s[2][3], s[3][3] = s[1][3], s[2][3], s[3][3], s[0][3]
 
        def __mix_single_column(self, a):
 
            t = a[0] ^ a[1] ^ a[2] ^ a[3]
            u = a[0]
            a[0] ^= t ^ xtime(a[0] ^ a[1])
            a[1] ^= t ^ xtime(a[1] ^ a[2])
            a[2] ^= t ^ xtime(a[2] ^ a[3])
            a[3] ^= t ^ xtime(a[3] ^ u)
 
 
        def __mix_columns(self, s):
            for i in range(4):
                self.__mix_single_column(s[i])
 
 
        def __inv_mix_columns(self, s):
            # see Sec 4.1.3 in The Design of Rijndael
            for i in range(4):
                u = xtime(xtime(s[i][0] ^ s[i][2]))
                v = xtime(xtime(s[i][1] ^ s[i][3]))
                s[i][0] ^= u
                s[i][1] ^= v
                s[i][2] ^= u
                s[i][3] ^= v
 
            self.__mix_columns(s)
        
 
